{
  "name": "arkadia-crowd-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker gathering the crowd-sourced spis zlomu and odmiany from players who opt in.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply arkadia-crowd --remote",
    "migrate:local": "wrangler d1 migrations apply arkadia-crowd --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.42.0"
  }
}
