{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "typeRoots": [
      "../node_modules/@types",
      "../src/client/types",
      "../src/web/types",
      "../types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/client/types/*.d.ts",
    "../src/web/types/*.d.ts",
    "../types/*.d.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
