# Build-time overrides for non-Arkadia deployments.
# Copy to .env (or .env.local for dev-only) and fill in your values.
#
# WebSocket server URL
# VITE_WEBSOCKET_URL=wss://your-mud.example.com/wss
#
# Map data source URLs
# VITE_MAP_DATA_URL=https://example.com/data/mapExport.json
# VITE_MAP_COLORS_URL=https://example.com/data/colors.json
# VITE_MAP_RELEASE_URL=https://api.github.com/repos/owner/repo/releases/latest
