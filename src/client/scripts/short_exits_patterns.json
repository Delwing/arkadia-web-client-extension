        "type": 1
      },
      {
        "pattern": "^Mozesz stad poplynac na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^W mroku nocy dostrzegasz .* widoczne wyjsci.: (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Tunel ciagnie sie na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Jaskinie ciagna sie na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Tunele ciagna sie na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Rozpadlina ciagnie sie na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^W gestych ciemnosciach dostrzegasz sciezke wiodaca na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Ulice krzyzuja sie tutaj, prowadzac w trzech kierunkach: (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Ulica prowadzi na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Wykop konczy sie tutaj, zas jedyne widoczne przejscie prowadzi na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Wykopany w ziemi tunel rozgalezia sie tutaj, zas jego odnogi wioda na (.*)\\.$",
        "type": 1
      },
      {
