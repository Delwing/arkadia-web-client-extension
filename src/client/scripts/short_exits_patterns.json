        "type": 1
      },
      {
        "pattern": "^Mozesz skierowac lodz na (.*)\\.$",
        "type": 1
      },
      {
        "pattern": "^Trakt jest zasypany glazami i mozna podazac nim tylko w jednym kierunku, na (.*)\\.$",
