{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "incremental": true,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "typeRoots": [
      "../node_modules/@types",
      "../options/src",
      "../client/src/types",
      "./src/types",
      "node_modules/@types"
    ],
    "paths": {
      "@options/*": [
        "../options/*"
      ],
      "@client/*": [
        "../client/*"
      ],
    }
  },
  "include": [
    "src"
  ]
}
